# ============================================================
# Contanika - Plantilla de variables de entorno
# Copiar este archivo como .env y ajustar los valores locales.
# El archivo .env nunca se sube al repositorio.
# ============================================================

# Entorno de ejecución: local | produccion
ENTORNO=local

# Clave secreta de Django (generar una nueva para producción)
SECRET_KEY=clave-secreta-de-desarrollo-solo-local
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos PostgreSQL local
BD_NOMBRE=contanika_bd
BD_USUARIO=contanika
BD_CLAVE=contanika
BD_HOST=127.0.0.1
BD_PUERTO=5432

# Base de datos de producción (Supabase)
BD_URL_SUPABASE=

# Correo electrónico saliente (alertas y cuentas de cobro)
CORREO_HOST=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_REMITENTE=Contanika <no-responder@contanika.co>

# Dirección pública del sistema, base de los enlaces que reciben los clientes
# (PDF de la cuenta de cobro por WhatsApp). En producción, el dominio real.
URL_SITIO=http://127.0.0.1:8000

# Seguridad: bloqueo de intentos fallidos de inicio de sesión
AXES_INTENTOS_MAXIMOS=5
AXES_TIEMPO_BLOQUEO_HORAS=1

# Cifrado de credenciales (Módulo 1)
# Generar una clave valida con: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENCIAL_CLAVE_CIFRADO=

# Archivos en Supabase Storage (producción)
SUPABASE_URL=
SUPABASE_CLAVE_SERVICIO=
